# 项目自管 Redis 实例配置（deploy/redis/docker-compose.yml）。
# 复制为 deploy/redis/.env 后使用；推荐直接运行 `bash scripts/redis.sh init`，
# 由脚本生成随机密码并以 0600 落盘（deploy/redis/.env 已被 .gitignore 忽略）。
#
# 端口默认 6380：避开本机可能已存在的其它 Redis（6379），互不干扰。
HDB_REDIS_PORT=6380

# 必填。建议 32 位 hex（openssl rand -hex 16），避免 URL 转义问题。
# 脚本 `up` 会把完整 REDIS_URL（含本密码）写入应用 .env；两处必须一致。
REDIS_PASSWORD=change-me
