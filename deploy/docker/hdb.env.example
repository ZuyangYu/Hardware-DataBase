# =============================================================================
# Hardware DataBase —— Docker 部署配置模板
#
# 用法（在 compose 文件所在目录）：
#   cp hdb.env.example config/.env
#   vi config/.env          # 至少填 AUTH_DEFAULT_ADMIN_PASSWORD 与 RAGFLOW_*
#   docker compose up -d
#
# 该文件会被挂载为容器内 /app/config/.env（HDB_ENV_PATH）：
#   - 启动时按此配置加载；
#   - 管理员在「系统配置」页面保存时，会原子写回本文件（重启类配置需重启容器）。
# 这里只列 Docker 部署最常用的键；完整 200+ 配置项、默认值与说明见仓库根
# .env.example 与 wiki/20-config-and-storage.md。未列出的键全部按代码默认值生效。
# =============================================================================

# ---- 首次启动的管理员（必填，不能为空、不能是 admin123）----
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=
# External access is enabled per employee by creating a Key in personal settings.
# The lines below are optional tuning/defaults, not feature switches.
# Optional hardening: set a secret pepper to invalidate all keys when rotated.
HDB_API_KEY_PEPPER=
# API Key 默认 90 天，最大 365 天；到期后自动失效。
HDB_API_KEY_DEFAULT_TTL_DAYS=90
HDB_API_KEY_MAX_TTL_DAYS=365
HDB_EXTERNAL_ALL_KBS_MODE_ENABLED=false
HDB_EXTERNAL_RATE_LIMIT_BACKEND=redis
HDB_EXTERNAL_DAILY_QUOTA=10000

# ---- 服务监听（容器内固定 8001；HDB_API_HOST 必须是 0.0.0.0，否则容器外访问不到）----
# 注意：这两项与 compose/nginx 内写死的 8001 端口绑定，通常不要修改；
#       改了必须同步改 deploy/docker/docker-compose.yml 与 nginx.conf 后重启。
HDB_API_HOST=0.0.0.0
HDB_API_PORT=8001

# ---- RAGFlow 文档检索后端（外部服务，必须可达）----
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_GOVERNANCE_DATASET_NAME=department_governance
RAGFLOW_DESIGN_DATASET_NAME=project_design_assets

# ---- Agent / 后台任务使用的模型 ----
# provider 取值：ollama（内网 Ollama 服务，默认）| custom（OpenAI 兼容 API）
AGENT_LLM_PROVIDER=ollama
AGENT_OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_OLLAMA_MODEL=qwen2.5:32b
# 仅 provider=custom 时生效：
AGENT_CUSTOM_BASE_URL=
AGENT_CUSTOM_MODEL=
AGENT_CUSTOM_API_KEY=

# ---- 账本数据库（由 docker compose 注入，见 docker-compose.yml 的 x-pg-env）----
# 默认指向 compose 内的 postgres（pgvector），控制面、认证域及生产域 DSN 都由编排注入，
# 这里不用填。若要指向**已有 PostgreSQL**（不启动 compose 的 postgres 服务）：
#   CONTROL_PLANE_BACKEND=postgres
#   CONTROL_PLANE_DATABASE_URL=postgresql://hdb:密码@你的主机:5432/hdb
#   MEMORY_STORE_BACKEND=postgres / MEMORY_DATABASE_URL=同上
#   AGENT_CHECKPOINT_BACKEND=postgres / AGENT_CHECKPOINT_DATABASE_URL=同上
#   RESOURCE_GOVERNOR_BACKEND=postgres / RESOURCE_GOVERNOR_DATABASE_URL=同上
#   RESOURCE_GOVERNOR_SCOPE=deployment

# ---- Redis 实时平面（必需，随编排一起启动）----
# 与 PG 一样是部署必备组件；默认指向 compose 内的 redis。它只存带 TTL 的加速键
# （取消标记 / 事件流），真相在 PG，因此不需要备份；Redis 故障时代码自动降级。
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true

# ---- 常用可选项 ----
# PDF 导出中文字体：镜像已内置 DroidSansFallback，无需设置；如需换字体再填绝对路径。
# RESULT_EXPORT_PDF_FONT=
# 会话附件 OCR 默认开启（镜像已内置 tesseract-ocr + poppler-utils）；视觉解析默认关闭。
# CHAT_ATTACHMENT_OCR_ENABLED=true
# CHAT_ATTACHMENT_VISUAL_ENABLED=false
# 长期记忆（LangMem）：由独立 memory worker 消费；单进程宿主机模式可由 API 内嵌管理。
# MEMORY_ENABLED=true

# =============================================================================
# 生产推荐档位（直接复制下面需要的几行到 config/.env，不用一个个试）
# =============================================================================
#
# 【建议打开】面向用户、且不需要额外基础设施：
# RESOURCE_GOVERNOR_ENABLED=true         # 资源配额/许可租约（单机建议 process 作用域）
# RESOURCE_GOVERNOR_SCOPE=process
#
# 【按需打开】：
# CHAT_ATTACHMENT_OCR_ENABLED=true       # 需镜像装 tesseract-ocr + poppler-utils
# CHAT_ATTACHMENT_VISUAL_ENABLED=true    # 需多模态端点 + CHAT_ATTACHMENT_REMOTE_INFERENCE_ALLOWED
# PROVIDER_RPM_LIMIT=600                 # 供应商预算（0=关闭；填你配额的下限）
# PROVIDER_TPM_LIMIT=200000
#
# 文档创作高级执行路径（planning v2 / shadow / DAG / template-free）、
# 并行执行器、子代理和共享检索执行器均为代码内常量，不再提供 env 开关。
#
# 【多副本才需要】：
# DISTRIBUTED_ADMISSION_ENABLED=true     # 跨副本共享配额（Redis fail-closed）
# RESOURCE_GOVERNOR_SCOPE=deployment
# 并关闭 HDB_API_SPAWN_WORKER / _EXPORT_WORKER / _MEMORY_WORKER（改为独立 worker 容器）

# ---- 开箱即用：以下为生产默认开启项 ----
RESOURCE_GOVERNOR_ENABLED=true
RESOURCE_GOVERNOR_SCOPE=deployment
# Docker 部署使用 deployment（多进程/多容器共享配额），与 compose 保持一致。
# 这里不要再写 process：保存「系统配置」时会以本文件为准覆盖环境变量，
# 导致 RESOURCE_GOVERNOR_BACKEND=postgres 配 scope=process 而校验失败。
CHAT_ATTACHMENT_OCR_ENABLED=true

# ---- 生产观测（默认开启）----
# quickstart 默认会通过 docker-compose.observability.yml 同网络启动
# Collector/Prometheus/Tempo/Loki/Grafana/Phoenix，并把 endpoint 注入 API。
# 这里留空，保证显式 --without-observability 时不会连接不存在的 Collector；
# 不要把 otel-collector 写进此文件，服务名只在观测覆盖编排中有效。
OBS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
