  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chat queue depth / oldest age",
      "datasource": {
        "type": "prometheus",
        "uid": "hdb-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0,
        "i": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (hdb_queue_depth{queue=\"chat\"})",
          "legendFormat": "depth"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (hdb_queue_oldest_age_seconds{queue=\"chat\"})",
          "legendFormat": "oldest (s)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
