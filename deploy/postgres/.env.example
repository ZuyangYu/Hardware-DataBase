# 项目自管 PostgreSQL 配置（deploy/postgres/docker-compose.yml）。
# 复制为 deploy/postgres/.env 后使用；推荐直接运行 `bash scripts/postgres.sh init`，
# 由脚本生成随机密码并以 0600 落盘（deploy/postgres/.env 已被 .gitignore 忽略）。
#
# 端口默认 55433：机器上已有演练用的 PG（55432）和 RAGFlow 的 MySQL（3306），互不干扰。
HDB_PG_PORT=55433

# 必填。建议 32 位 hex（openssl rand -hex 16），避免 URL 转义问题。
# 脚本 `up` 会把完整 DSN 写入应用 .env（控制面/记忆/检查点/配额四处）。
POSTGRES_PASSWORD=change-me

# 连接池（控制面用）与库名，一般无需改。
POSTGRES_USER=hdb
POSTGRES_DB=hdb
