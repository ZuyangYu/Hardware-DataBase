        <mxCell id="b8_body" value="&lt;div style=&#x27;font-size:11px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 较低 recursion limit（deep rounds×12 / fast rounds×6，cap 72）&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 到限即部分交付&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 前端「预算用完 / 继续 / 缩小范围」&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="112" y="1264" width="714" height="78" as="geometry"/></mxCell>
