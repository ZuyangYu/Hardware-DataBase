        <mxCell id="b9_title" value="前端呈现" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13.5;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="1380" width="712" height="22" as="geometry"/></mxCell>
        <mxCell id="b9_body" value="&lt;div style=&#x27;font-size:11px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 执行计划 / 预算 / 系统校验卡片 + 执行轨迹&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 信息密度高，过程噪声大&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 用户需要分辨哪些是过程、哪些是结论&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="112" y="1408" width="714" height="78" as="geometry"/></mxCell>
