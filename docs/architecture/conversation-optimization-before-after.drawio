        <mxCell id="a3_body" value="&lt;div style=&#x27;font-size:11px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 全部命中先进入 candidate_evidence&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 返回 id / 来源 / 定位 / score / ≤180 字摘要&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 候选上限 60；不可引用、不占正式预算&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1292" y="544" width="714" height="78" as="geometry"/></mxCell>
