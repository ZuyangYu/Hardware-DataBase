        <mxCell id="r1_l1" value="&lt;div style=&#x27;padding:1px 1px 0 1px&#x27;&gt;&lt;div style=&#x27;font-size:14px;font-weight:700;color:#0F172A;line-height:1.3;margin-bottom:5px&#x27;&gt;ChatPage · useKbChat&lt;/div&gt;&lt;div style=&#x27;font-size:12px;color:#475569;line-height:1.58&#x27;&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; SSE 实时轨迹 / 引用 / 脚注&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 刷新、切页不丢 turn&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 回答内「导出结果」菜单&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 附件预检（不可信上下文）&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacing=10;spacingTop=9;" vertex="1" parent="1"><mxGeometry x="280" y="251" width="360" height="168" as="geometry"/></mxCell>
