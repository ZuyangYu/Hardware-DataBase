        <mxCell id="deploy_title" value="部署与进程拓扑 · deploy/docker/docker-compose.yml（生产默认，全部容器化）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="1940" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="deploy_note" value="单机开发：uv run hardware-database-server + npm run dev · 多实例：关闭 HDB_API_SPAWN_*，worker 独立起、memory 单写者" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10.5;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1180" y="1940" width="1360" height="26" as="geometry"/></mxCell>
        <mxCell id="deploy_g1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="1974" width="760" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy_g1_title" value="入口与账本" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="74" y="1982" width="732" height="22" as="geometry"/></mxCell>
        <mxCell id="deploy_g1_body" value="&lt;div style=&#x27;font-size:10.5px;color:#475569;line-height:1.72&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; web（nginx :8080）→ api（FastAPI :8001）&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; migrate（一次性 bootstrap）→ postgres · pgvector:pg17&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; redis:8-alpine · 实时面（SSE / 取消 / 准入）&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="74" y="2008" width="732" height="78" as="geometry"/></mxCell>
        <mxCell id="deploy_g2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1974" width="820" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy_g2_title" value="独立后台 Worker（各一容器）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="854" y="1982" width="792" height="22" as="geometry"/></mxCell>
        <mxCell id="deploy_g2_body" value="&lt;div style=&#x27;font-size:10.5px;color:#475569;line-height:1.72&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; worker-chat / worker-parse&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; worker-export / worker-memory&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; worker-evaluation / worker-quality&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 另有 maintenance / e2e CLI&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="854" y="2008" width="792" height="78" as="geometry"/></mxCell>
        <mxCell id="deploy_g3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1680" y="1974" width="860" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy_g3_title" value="外部依赖 / 单机形态" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1694" y="1982" width="832" height="22" as="geometry"/></mxCell>
        <mxCell id="deploy_g3_body" value="&lt;div style=&#x27;font-size:10.5px;color:#475569;line-height:1.72&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; RAGFlow：固定文档解析与检索后端&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; LLM：Ollama 或任意 OpenAI 兼容 API&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 单机 server 可自启 worker + export worker&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1694" y="2008" width="832" height="78" as="geometry"/></mxCell>
        <mxCell id="legend_title" value="读法" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="2142" width="60" height="22" as="geometry"/></mxCell>
        <mxCell id="legend_body" value="每一行是一条业务链路，按 L1 → L5 从左到右阅读；箭头只连接同一行相邻层，不跨行、不交叉。数据列重复列出该链路实际读写的后端，便于按域追踪。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11.5;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="120" y="2142" width="1500" height="22" as="geometry"/></mxCell>
        <mxCell id="legend_colors" value="&lt;span style=&#x27;color:#2563EB&#x27;&gt;■ 问答&lt;/span&gt;　&lt;span style=&#x27;color:#059669&#x27;&gt;■ 摄取&lt;/span&gt;　&lt;span style=&#x27;color:#D97706&#x27;&gt;■ 治理&lt;/span&gt;　&lt;span style=&#x27;color:#7C3AED&#x27;&gt;■ 资产&lt;/span&gt;　&lt;span style=&#x27;color:#0D9488&#x27;&gt;■ 导出&lt;/span&gt;　&lt;span style=&#x27;color:#DB2777&#x27;&gt;■ 评估&lt;/span&gt;　&lt;span style=&#x27;color:#EA580C&#x27;&gt;■ 扩展&lt;/span&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;■ 运维&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1620" y="2142" width="940" height="22" as="geometry"/></mxCell>
