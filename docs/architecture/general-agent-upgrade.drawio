        <mxCell id="a2_body" value="&lt;div style=&#x27;font-size:10.8px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 聊天 turn 用 trace_context.workspace_id 关联&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 不建 task，复用 turn 队列 / fencing / SSE&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 显式 /tasks 保留，task 模型不变&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="382" width="718" height="90" as="geometry"/></mxCell>
