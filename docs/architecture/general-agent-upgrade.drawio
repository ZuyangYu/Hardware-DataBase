        <mxCell id="a1_body" value="&lt;div style=&#x27;font-size:10.8px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; Workspace = 项目容器，kind=general|knowledge&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 1 个 workspace 下挂 1..N 个 session&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 知识库只是可选绑定，未绑定即通用工作区&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="232" width="718" height="90" as="geometry"/></mxCell>
