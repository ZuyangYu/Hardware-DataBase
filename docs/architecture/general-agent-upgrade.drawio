        <mxCell id="b2_body" value="&lt;div style=&#x27;font-size:10.8px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 聊天 turn 自动创建 task / task_pending&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 聊天与任务工作台共用 task 模型&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 会话结束即任务结束&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="382" width="718" height="90" as="geometry"/></mxCell>
