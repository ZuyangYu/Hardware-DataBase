        <mxCell id="a6_body" value="&lt;div style=&#x27;font-size:10.8px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 产物按 turn_id 挂在 assistant 消息下&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 「处理过程」只投影真实工具动作&lt;br&gt;&lt;span style=&#x27;color:#2563EB&#x27;&gt;•&lt;/span&gt; 流式统一「正在处理」，过程与结论分离&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="982" width="718" height="90" as="geometry"/></mxCell>
