        <mxCell id="b1_body" value="&lt;div style=&#x27;font-size:10.8px;color:#334155;line-height:1.45&#x27;&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 会话只承载单次问答&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 知识库是会话的前置上下文&lt;br&gt;&lt;span style=&#x27;color:#94A3B8&#x27;&gt;•&lt;/span&gt; 没有跨会话的项目容器&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="110" y="232" width="718" height="90" as="geometry"/></mxCell>
