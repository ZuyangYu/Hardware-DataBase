# ============================================================
# Hardware DataBase 配置文件模板
# 复制此文件为 .env 并填写你的配置: cp .env.example .env
# 变量以 config/settings.py 实际读取的为准
# ============================================================

# ==================== RAGFlow 后端 ====================
# 文档检索统一由 RAGFlow 承担，embedding 与解析在 RAGFlow 侧完成，
# 本项目不再配置本地 embedding / reranker / BM25。
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_GOVERNANCE_DATASET_NAME=ADAS_new_develop
RAGFLOW_DESIGN_DATASET_NAME=ADAS_new_develop
RAGFLOW_TIMEOUT_SECONDS=120
RAGFLOW_SIMILARITY_THRESHOLD=0.25
RAGFLOW_VECTOR_WEIGHT=0.4

# ==================== Agent LLM ====================
# provider: ollama | custom
AGENT_LLM_PROVIDER=ollama
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=120
# HTTP 429 重试（仅 custom 提供商生效；重试耗尽后抛出原始错误）
AGENT_RATE_LIMIT_MAX_RETRIES=4
AGENT_RATE_LIMIT_INITIAL_DELAY_SECONDS=1
AGENT_RATE_LIMIT_MAX_DELAY_SECONDS=16

# Agentic document authoring remains disabled until its parity/migration gates
# are approved. Chat document tools are an independent, separately gated flag.
DOCUMENT_AUTHORING_AGENT_MODE_ENABLED=false
AGENT_DOCUMENT_TOOLS_ENABLED=false
DOCUMENT_AUTHORING_CHECKPOINTER_BACKEND=sqlite
# Relative paths are resolved below storage/; use an absolute path in a
# multi-process deployment only after the shared PostgreSQL backend is ready.
DOCUMENT_AUTHORING_CHECKPOINTER_PATH=document_authoring_checkpoints.sqlite
DOCUMENT_AUTHORING_JOB_LEASE_SECONDS=300
DOCUMENT_AUTHORING_JOB_BATCH_SIZE=4

# --- 场景 1: 纯本地 Ollama（默认 / 免费）---
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen2.5:32b

# --- 场景 2: OpenAI 官方（将上方 AGENT_LLM_PROVIDER 改为 custom）---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://api.openai.com/v1
# AGENT_CUSTOM_MODEL=gpt-4o
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 3: OpenRouter ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_CUSTOM_MODEL=anthropic/claude-3.5-sonnet
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 4: DeepSeek ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://api.deepseek.com/v1
# AGENT_CUSTOM_MODEL=deepseek-chat
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 5: 通义千问 ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_CUSTOM_MODEL=qwen-plus
# AGENT_CUSTOM_MAX_TOKENS=4096

# ==================== 检索与 Agent 行为 ====================
FINAL_TOP_K=5
# 控制 deepagents 循环的 recursion_limit 预算：deep 模式 ≈ rounds*12，fast 模式 ≈ rounds*6。
# 调大检索更充分但更慢，调小更快但可能检索不足。
AGENT_MAX_RETRIEVAL_ROUNDS=3

# ==================== LangMem 长期记忆 ====================
# 记忆提炼在独立 Worker 中低优先级运行；默认不让 API 进程自动拉起 Worker。
MEMORY_ENABLED=true
MEMORY_STORE_BACKEND=sqlite
# Relative paths are resolved under STORAGE_DIR; use an absolute path in production.
MEMORY_SQLITE_PATH=memory.db
MEMORY_SQLITE_BUSY_TIMEOUT_MS=30000
# Phase 1 requires one Memory Worker process per control-plane database.
MEMORY_SINGLE_WRITER=true
MEMORY_EXTRACTION_ENABLED=true
MEMORY_DEBOUNCE_SECONDS=300
MEMORY_JOB_LEASE_SECONDS=180
MEMORY_JOB_MAX_RETRIES=5
MEMORY_JOB_MAX_CONCURRENCY=1
MEMORY_REFLECTION_TIMEOUT_SECONDS=120
MEMORY_PROJECTION_MAX_RETRIES=5
MEMORY_REFLECTION_MIN_INTERVAL_SECONDS=0
MEMORY_REFLECTION_CIRCUIT_FAILURES=5
MEMORY_REFLECTION_CIRCUIT_COOLDOWN_SECONDS=60
MEMORY_RECONCILE_INTERVAL_SECONDS=3600
MEMORY_MODEL_PROVIDER=
MEMORY_MODEL=
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_API_KEY=
MEMORY_USER_TOP_K=3
MEMORY_PROJECT_TOP_K=5
MEMORY_STORE_OVERSAMPLE_FACTOR=4
MEMORY_STORE_MAX_SCAN=100
MEMORY_CONTEXT_MAX_TOKENS=1800
MEMORY_ITEM_MAX_TOKENS=350
# Only enable after calibrating the embedding score distribution.
MEMORY_MIN_SCORE_ENABLED=false
MEMORY_MIN_SCORE=
# Candidate 检索需要可用的语义索引；未配置 embedding 时会安全跳过 Candidate。
MEMORY_EMBEDDING_PROVIDER=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_DIMS=
MEMORY_INDEX_FIELDS=content.content,content.title,content.subject
# General chats do not create project memories. Per-event consent remains explicit.
MEMORY_ALLOW_GENERAL_CHAT_EXTRACTION=false
# User Memory 默认 opt-out，只有显式 consent event 才会提炼。
MEMORY_USER_MEMORY_OPT_IN=false
MEMORY_USER_MEMORY_REQUIRE_PER_EVENT_CONSENT=true
# 留空表示不自动执行保留期清理；仅对个人记忆和已进入终态的项目记忆生效。
MEMORY_RETENTION_DAYS=
# 单机部署可设为 true；多实例部署建议单独运行 hardware-database-memory-worker。
HDB_API_SPAWN_MEMORY_WORKER=false

# ==================== Observability ====================
# Telemetry is fail-open: the app continues working if the Collector/backends are down.
OBS_ENABLED=true
OTEL_SERVICE_NAME=hardware-database-api
# For an API/Worker started on the host use http://127.0.0.1:4317.
# Use http://otel-collector:4317 only when the API/Worker joins this Compose network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OBS_ENVIRONMENT=development
OBS_SERVICE_VERSION=0.1.0
OBS_TRACE_SAMPLE_RATIO=1.0
OBS_CAPTURE_CONTENT=false
OBS_CAPTURE_QUERY=false
OBS_CAPTURE_EVIDENCE=false
OBS_CAPTURE_LLM_CONTENT=false
# Content capture is opt-in. Increase only when Phoenix needs full prompts,
# answers, or retrieved evidence; large values increase trace payload size.
OBS_CONTENT_MAX_CHARS=50000
OBS_LOG_FORMAT=json
OBS_METRICS_ENABLED=true
OBS_TRACES_ENABLED=true
OBS_LOGS_ENABLED=true
OBS_PHOENIX_PROJECT=hardware-database
# OBS_GRAFANA_BASE_URL=http://localhost:3000
# OBS_PHOENIX_BASE_URL=http://localhost:6006
OBS_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
OBS_WORKER_STALE_SECONDS=30
OBS_DEPENDENCY_TIMEOUT_SECONDS=5

# ==================== RAGAS 评估（可选）====================
# 裁判 LLM 默认复用 AGENT_*；设置 EVAL_LLM_PROVIDER 后使用以下独立配置。
# EVAL_LLM_PROVIDER=custom
# EVAL_LLM_BASE_URL=https://api.openai.com/v1
# EVAL_LLM_API_KEY=
# EVAL_LLM_MODEL=gpt-4o-mini
# EVAL_LLM_MAX_TOKENS=8192
# EVAL_MAX_CONTEXTS_PER_SAMPLE=4
# EVAL_MAX_CONTEXT_CHARS=4000
# EVAL_MAX_CONTEXT_CHARS_PER_ITEM=1200
# EVAL_SCORING_MAX_BUDGET_ATTEMPTS=3
# EVAL_SCORING_CONTEXT_SHRINK_FACTOR=0.5
# Embedding 无现有配置可复用，运行 RAGAS 标准指标时必须显式设置。
# EVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# EVAL_EMBEDDING_API_KEY=
# EVAL_EMBEDDING_MODEL=text-embedding-3-small
# EVAL_EMBEDDING_DIMS=2048
# EVAL_TIMEOUT_SECONDS=120
# EVAL_MAX_WORKERS=4
# EVAL_MAX_RETRIES=2
# EVAL_OUTPUT_ROOT=storage/evaluations

# ==================== Authentication ====================
# 登录强制开启。首次启动前请为 admin 设置一个强密码。
AUTH_DB_PATH=storage/auth.db
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=
AUTH_SESSION_TTL_HOURS=24

# ==================== 存储路径（通常无需修改）====================
PIPELINE_ARCHIVE_ROOT=storage/pipeline_archives
RAGFLOW_FILE_ROOT=storage/pipeline_archives

# ==================== 提示词（可选，覆盖默认 Agent 提示词）====================
# SYSTEM_PROMPT=你是一个专业的硬件技术助手...（支持 {kb_name} 与 {workflow} 占位符）
# NO_CONTEXT_PROMPT=（知识库中未检索到任何证据时返回给用户的最终回答）

# ==================== CLI / API 服务（可选）====================
# hardware-database-server 监听地址与端口（服务端）。
HDB_API_HOST=127.0.0.1
HDB_API_PORT=8003
# CLI 连接的 API 地址。优先级: --api-url > HDB_API_URL > 会话文件 > 默认 http://127.0.0.1:8003
HDB_API_URL=http://127.0.0.1:8003
# CORS 允许的来源（逗号分隔，浏览器前端用）。未设置时默认本地开发 origin
# （Streamlit 8501 + 前端 dev 3000/5175）。生产部署必须显式设为前端实际域名。
HDB_API_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# CLI 访问令牌（免 login，便于脚本/CI；也可用 --token 传入）。
# HDB_TOKEN=
