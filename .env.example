# ============================================================
# Hardware DataBase 配置文件模板
# 复制此文件为 .env 并填写你的配置: cp .env.example .env
# 变量以 config/settings.py 实际读取的为准
# ============================================================

# ==================== RAGFlow 后端 ====================
# 文档检索统一由 RAGFlow 承担，embedding 与解析在 RAGFlow 侧完成，
# 本项目不再配置本地 embedding / reranker / BM25。
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_GOVERNANCE_DATASET_NAME=ADAS_new_develop
RAGFLOW_DESIGN_DATASET_NAME=ADAS_new_develop
RAGFLOW_TIMEOUT_SECONDS=120
RAGFLOW_SIMILARITY_THRESHOLD=0.25
# 后台 worker 同步仍在解析中的文档状态的最小间隔（秒）；上传时读不到实时进度的部署靠它落终态。
RAGFLOW_STATUS_REFRESH_MIN_SECONDS=60
RAGFLOW_VECTOR_WEIGHT=0.4

# ==================== Agent LLM ====================
# provider: ollama | custom
AGENT_LLM_PROVIDER=ollama
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=120
# HTTP 429 重试（仅 custom 提供商生效；重试耗尽后抛出原始错误）
AGENT_RATE_LIMIT_MAX_RETRIES=4
AGENT_RATE_LIMIT_INITIAL_DELAY_SECONDS=1
AGENT_RATE_LIMIT_MAX_DELAY_SECONDS=16
# Agent thread state is stored separately from document-authoring checkpoints.
AGENT_CHECKPOINT_DB_PATH=agent_checkpoints.db
# Context-window metadata for deepagents summarization/compaction (not a hard
# provider request-length limit).
AGENT_MODEL_MAX_INPUT_TOKENS=65536

# 进程级 LLM 并发闸门（src/core/llm_governor.py）：
# LLM_MAX_CONCURRENCY 全局并发；LLM_BATCH_MAX_CONCURRENCY 为 wiki/记忆抽取等
# 批量任务保留的并发上限（批量永远不能占满，交互查询有预留）；排队超过
# LLM_QUEUE_WARN_SECONDS 记警告，超过 LLM_QUEUE_TIMEOUT_SECONDS 抛超时（0=不限）。
LLM_MAX_CONCURRENCY=4
LLM_BATCH_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_SECONDS=180
LLM_QUEUE_WARN_SECONDS=10
LLM_STREAM_IDLE_TIMEOUT_SECONDS=0

# --- 生产化（P0a/P0b）功能开关：默认关闭，完成阶段验收后逐项打开 ---
# 同会话严格按服务端 turn_sequence 串行执行，并启用 lease/fencing 拒写。
CONVERSATION_SERIALIZE_SAME_THREAD=false
CHAT_TURN_LEASE_SECONDS=120
CHAT_TURN_LEASE_RENEW_SECONDS=15
# 附件解析等待上限；超时后本轮失败并推进同会话后序 turn（秒）。
WAITING_TURN_MAX_SECONDS=600
WAITING_TURN_TIMEOUT_SCAN_SECONDS=5
# Worker 角色：all(本地开发) | chat | authoring | parse。
WORKER_ROLE=all
# 多槽 worker 每次循环最多认领的 turn 数（WORKER_TURN_CONCURRENCY > 1 时生效）。
WORKER_CLAIM_BATCH_SIZE=8
# 部署级资源配额：deployment 作用域共享 SQLite 配额库（同主机多进程）。
RESOURCE_GOVERNOR_ENABLED=false
RESOURCE_GOVERNOR_SCOPE=process
RESOURCE_GOVERNOR_DB_PATH=resource_quotas.db
# 配额存储后端：sqlite（同主机共享文件，默认）| postgres（跨主机共享，需 URL 且 SCOPE=deployment）。
RESOURCE_GOVERNOR_BACKEND=sqlite
RESOURCE_GOVERNOR_DATABASE_URL=
RESOURCE_GOVERNOR_DEPLOYMENT_ID=local
RESOURCE_GOVERNOR_REQUIRE_PRECONFIGURED=false
RESOURCE_PERMIT_LEASE_SECONDS=300
RESOURCE_UNCERTAIN_ESCALATE_SECONDS=600
RESOURCE_QUEUE_MAX_WAIT_SECONDS=30
RESOURCE_QUEUE_MAX_DEPTH=256
CHAT_QUEUE_DEADLINE_SECONDS=600
RESOURCE_RAG_MAX_CONCURRENT=8
RESOURCE_RAG_RESERVED_INTERACTIVE=4
# 共享有界检索执行器（document_search_batch 不再每次新建线程池）。
SHARED_RETRIEVAL_EXECUTOR_ENABLED=false
RETRIEVAL_EXECUTOR_MAX_WORKERS=8
RETRIEVAL_PER_REQUEST_FANOUT=4
# Agent Checkpoint 后端：sqlite（默认）| postgres（需 DATABASE_URL 与版本验证）。
AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_DATABASE_URL=
DOCUMENT_AUTHORING_CHECKPOINTER_DATABASE_URL=
# 控制面后端：sqlite（默认，auth.db）| postgres。
# postgres 需显式 CONTROL_PLANE_DATABASE_URL（正式 DDL 先建好，readiness 校验 schema
# 版本，缺失即 fail-closed）。PG 承载会话/执行/记忆账本/导出账本；鉴权、审计日志、
# 文档生成与附件字节仍留在本地 SQLite（独立授权/日志域，不参与控制面事务）。
# 切换流程：停写 → 快照导入（load_sqlite_into_postgres.py）→ 校验归零 →
# 回滚演练（cutover_rehearsal.py）；多进程部署同时设置 HDB_API_SPAWN_*=0。
CONTROL_PLANE_BACKEND=sqlite
CONTROL_PLANE_DATABASE_URL=
CONTROL_PLANE_POOL_SIZE=8
# Redis 实时平面：取消快路径（空 URL 关闭；持久取消标志始终是权威兜底）。
REDIS_URL=
CANCEL_FAST_PATH_ENABLED=true
CANCEL_KEY_TTL_SECONDS=7200
# 跨进程 SSE 事件流（有界 + TTL；PG 回放始终是唯一真相）。
TURN_EVENT_STREAM_TTL_SECONDS=7200
TURN_EVENT_STREAM_MAXLEN=5000
# 分布式准入（Redis Lua 共享配额；多 API 副本时必须启用，Redis 故障 fail-closed）。
DISTRIBUTED_ADMISSION_ENABLED=false
DISTRIBUTED_ADMISSION_TTL_SECONDS=120
# 供应商 RPM 预算（在模型边界计数；0=关闭；启用后 Redis 不可用则 fail-closed）。
PROVIDER_RPM_LIMIT=0
# 供应商 TPM 预算（估算输入+输出 token；0=关闭；启用后 Redis 不可用则 fail-closed）。
PROVIDER_TPM_LIMIT=0
# 入口准入限流（per-user/tenant/model + 资源类型 RPM；空值=继承基础桶）。
ADMISSION_CONTROL_ENABLED=true
ADMISSION_CHAT_RPM_PER_USER=30
ADMISSION_CHAT_RPM_PER_TENANT=120
ADMISSION_DEEP_RPM_PER_USER=
ADMISSION_DEEP_RPM_PER_TENANT=
ADMISSION_HEAVY_RPM_PER_USER=10
ADMISSION_HEAVY_RPM_PER_TENANT=40
ADMISSION_DOCUMENT_RPM_PER_USER=
ADMISSION_DOCUMENT_RPM_PER_TENANT=
ADMISSION_EXPORT_RPM_PER_USER=
ADMISSION_EXPORT_RPM_PER_TENANT=
ADMISSION_EVALUATION_RPM_PER_USER=
ADMISSION_EVALUATION_RPM_PER_TENANT=
ADMISSION_MODEL_RPM_PER_USER=
ADMISSION_MODEL_RPM_PER_TENANT=
ADMISSION_MAX_UNTERMINAL_TURNS_PER_SESSION=8
ADMISSION_MAX_UNTERMINAL_TURNS_PER_USER=32
# Action DAG 并行与可选 specialist subagent：默认关闭，需评测数据支持。
ACTION_DAG_PARALLEL_ENABLED=false
ACTION_EXECUTOR_MAX_PARALLEL=4
REVIEWER_AGENT_ENABLED=false
RESEARCH_AGENT_ENABLED=false

# Agentic document authoring remains disabled until its parity/migration gates
# are approved. Chat document tools are an independent, separately gated flag.
DOCUMENT_AUTHORING_AGENT_MODE_ENABLED=false
AGENT_DOCUMENT_TOOLS_ENABLED=false
DOCUMENT_AUTHORING_CHECKPOINTER_BACKEND=sqlite
# Relative paths are resolved below storage/; use an absolute path in a
# multi-process deployment only after the shared PostgreSQL backend is ready.
DOCUMENT_AUTHORING_CHECKPOINTER_PATH=document_authoring_checkpoints.sqlite
DOCUMENT_RISK_BASED_PLAN_GATE_ENABLED=false
DOCUMENT_TASK_STREAM_ENABLED=true
DOCUMENT_AUTHORING_JOB_LEASE_SECONDS=300
DOCUMENT_AUTHORING_JOB_BATCH_SIZE=4
DOCUMENT_AUTHORING_JOB_BATCH_TIME_BUDGET_SECONDS=10
# Phase 2 plan-backed execution is disabled until the offline parity baseline
# and the manual failure-boundary smoke record are approved.  All allowlists
# are exact normalized values; keep them empty for the default-safe rollout.
DOCUMENT_PLAN_DAG_EXECUTION_ENABLED=false
DOCUMENT_PLAN_DAG_ALLOWLIST_TENANTS=
DOCUMENT_PLAN_DAG_ALLOWLIST_DOCUMENT_TYPES=
DOCUMENT_PLAN_DAG_ALLOWLIST_FORMATS=
# Preview evidence retrieval retries transient embedding/transport failures
# before asking the user to retry. Attempts include the first try.
DOCUMENT_PREVIEW_RETRIEVAL_ATTEMPTS=3
DOCUMENT_PREVIEW_RETRIEVAL_BACKOFF_SECONDS=0.5
# Phase 3 template-free recipes are independently disabled by default. Enable
# only with exact tenant/document-type/format/recipe canary values.
DOCUMENT_TEMPLATE_FREE_EXECUTION_ENABLED=false
DOCUMENT_TEMPLATE_FREE_ALLOWLIST_TENANTS=
DOCUMENT_TEMPLATE_FREE_ALLOWLIST_DOCUMENT_TYPES=
DOCUMENT_TEMPLATE_FREE_ALLOWLIST_FORMATS=
DOCUMENT_TEMPLATE_FREE_ALLOWLIST_RECIPES=
# Phase 5 closure remains disabled until two-release no-new-legacy-write and
# backup/restore evidence has an operator sign-off.
DOCUMENT_AUTHORING_COMPATIBILITY_CLOSURE_ENABLED=false
DOCUMENT_AUTHORING_COMPATIBILITY_DB_PATH=document_authoring_compatibility.sqlite
RESULT_EXPORT_STORAGE_DIR=exports
RESULT_EXPORT_ENABLED=true
RESULT_EXPORT_MD_ENABLED=true
RESULT_EXPORT_XLSX_ENABLED=true
RESULT_EXPORT_DOCX_ENABLED=true
RESULT_EXPORT_PDF_ENABLED=true
RESULT_EXPORT_PPTX_ENABLED=true
RESULT_EXPORT_MAX_BYTES=26214400
RESULT_EXPORT_JOB_LEASE_SECONDS=300
RESULT_EXPORT_JOB_BATCH_SIZE=8
RESULT_EXPORT_RETENTION_DAYS=30
RESULT_EXPORT_MAX_RUNNING_JOBS=4
# 导出前整理：默认开启，由 Agent 按用户需求把回答整理成可交付内容；
# “原样导出”或置 false 时保留原始问答结构。
RESULT_EXPORT_ORGANIZE_ENABLED=true
RESULT_EXPORT_ORGANIZE_MAX_CHARS=40000

# --- 场景 1: 纯本地 Ollama（默认 / 免费）---
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=qwen2.5:32b

# --- 场景 2: OpenAI 官方（将上方 AGENT_LLM_PROVIDER 改为 custom）---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://api.openai.com/v1
# AGENT_CUSTOM_MODEL=gpt-4o
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 3: OpenRouter ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_CUSTOM_MODEL=anthropic/claude-3.5-sonnet
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 4: DeepSeek ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://api.deepseek.com/v1
# AGENT_CUSTOM_MODEL=deepseek-chat
# AGENT_CUSTOM_MAX_TOKENS=4096

# --- 场景 5: 通义千问 ---
# AGENT_LLM_PROVIDER=custom
# AGENT_CUSTOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AGENT_CUSTOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_CUSTOM_MODEL=qwen-plus
# AGENT_CUSTOM_MAX_TOKENS=4096

# ==================== 检索与 Agent 行为 ====================
FINAL_TOP_K=5
# 控制 deepagents 循环的 recursion_limit 预算：deep 模式 ≈ rounds*12，fast 模式 ≈ rounds*6。
# 调大检索更充分但更慢，调小更快但可能检索不足。
AGENT_MAX_RETRIEVAL_ROUNDS=3
# Agent 单题证据堆上限；对话附件存在时改用 AGENT_ATTACHMENT_EVIDENCE_BUDGET
# （两者取较大值），因为长文档精读需要更多证据槽位。
# AGENT_EVIDENCE_BUDGET=30
# AGENT_ATTACHMENT_EVIDENCE_BUDGET=80
# 审核结果等站内通知的可选外发 webhook；留空则只写站内通知。
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=
# NOTIFY_WEBHOOK_TIMEOUT_SECONDS=2
# PDF 重排使用 PDF 自带文本层（pypdf），无需 LibreOffice；扫描件会被拒绝。

# ==================== LangMem 长期记忆 ====================
# 记忆提炼在独立 Worker 中低优先级运行；默认不让 API 进程自动拉起 Worker。
MEMORY_ENABLED=true
MEMORY_STORE_BACKEND=sqlite
# Relative paths are resolved under STORAGE_DIR; use an absolute path in production.
MEMORY_SQLITE_PATH=memory.db
MEMORY_SQLITE_BUSY_TIMEOUT_MS=30000
# Phase 1 requires one Memory Worker process per control-plane database.
MEMORY_SINGLE_WRITER=true
MEMORY_EXTRACTION_ENABLED=true
MEMORY_DEBOUNCE_SECONDS=300
MEMORY_JOB_LEASE_SECONDS=180
MEMORY_JOB_MAX_RETRIES=5
MEMORY_REFLECTION_TIMEOUT_SECONDS=120
MEMORY_PROJECTION_MAX_RETRIES=5
MEMORY_REFLECTION_MIN_INTERVAL_SECONDS=0
MEMORY_REFLECTION_CIRCUIT_FAILURES=5
MEMORY_REFLECTION_CIRCUIT_COOLDOWN_SECONDS=60
MEMORY_RECONCILE_INTERVAL_SECONDS=3600
MEMORY_MODEL_PROVIDER=
MEMORY_MODEL=
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_API_KEY=
MEMORY_USER_TOP_K=3
MEMORY_PROJECT_TOP_K=5
MEMORY_STORE_OVERSAMPLE_FACTOR=4
MEMORY_STORE_MAX_SCAN=100
MEMORY_CONTEXT_MAX_TOKENS=1800
MEMORY_ITEM_MAX_TOKENS=350
# Only enable after calibrating the embedding score distribution.
MEMORY_MIN_SCORE_ENABLED=false
MEMORY_MIN_SCORE=
# Candidate 检索需要可用的语义索引；未配置 embedding 时会安全跳过 Candidate。
MEMORY_EMBEDDING_PROVIDER=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_DIMS=
MEMORY_INDEX_FIELDS=content.content,content.title,content.subject
# General chats do not create project memories. Per-event consent remains explicit.
MEMORY_ALLOW_GENERAL_CHAT_EXTRACTION=false
# User Memory 默认 opt-out，只有显式 consent event 才会提炼。
MEMORY_USER_MEMORY_OPT_IN=false
MEMORY_USER_MEMORY_REQUIRE_PER_EVENT_CONSENT=true
# 留空表示不自动执行保留期清理；仅对个人记忆和已进入终态的项目记忆生效。
MEMORY_RETENTION_DAYS=
# 单机部署可设为 true；多实例部署建议单独运行 hardware-database-memory-worker。
HDB_API_SPAWN_MEMORY_WORKER=false
# 单机部署可保持 true；多实例部署建议关闭并单独运行 export worker。
HDB_API_SPAWN_EXPORT_WORKER=true

# ==================== Observability ====================
# Telemetry is fail-open: the app continues working if the Collector/backends are down.
OBS_ENABLED=true
OTEL_SERVICE_NAME=hardware-database-api
# For an API/Worker started on the host use http://127.0.0.1:4317.
# Use http://otel-collector:4317 only when the API/Worker joins this Compose network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OBS_ENVIRONMENT=development
OBS_SERVICE_VERSION=0.1.0
OBS_TRACE_SAMPLE_RATIO=1.0
OBS_CAPTURE_CONTENT=false
OBS_CAPTURE_QUERY=false
OBS_CAPTURE_EVIDENCE=false
OBS_CAPTURE_LLM_CONTENT=false
# Content capture is opt-in. Increase only when Phoenix needs full prompts,
# answers, or retrieved evidence; large values increase trace payload size.
OBS_CONTENT_MAX_CHARS=50000
OBS_LOG_FORMAT=json
OBS_METRICS_ENABLED=true
OBS_TRACES_ENABLED=true
OBS_LOGS_ENABLED=true
OBS_PHOENIX_PROJECT=hardware-database
# OBS_GRAFANA_BASE_URL=http://localhost:3000
# OBS_PHOENIX_BASE_URL=http://localhost:6006
OBS_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
OBS_WORKER_STALE_SECONDS=30
OBS_DEPENDENCY_TIMEOUT_SECONDS=5

# ==================== RAGAS 评估（可选）====================
# 裁判 LLM 默认复用 AGENT_*；设置 EVAL_LLM_PROVIDER 后使用以下独立配置。
# EVAL_LLM_PROVIDER=custom
# EVAL_LLM_BASE_URL=https://api.openai.com/v1
# EVAL_LLM_API_KEY=
# EVAL_LLM_MODEL=gpt-4o-mini
# EVAL_LLM_MAX_TOKENS=8192
# EVAL_MAX_CONTEXTS_PER_SAMPLE=4
# EVAL_MAX_CONTEXT_CHARS=4000
# EVAL_MAX_CONTEXT_CHARS_PER_ITEM=1200
# EVAL_SCORING_MAX_BUDGET_ATTEMPTS=3
# EVAL_SCORING_CONTEXT_SHRINK_FACTOR=0.5
# Embedding 无现有配置可复用，运行 RAGAS 标准指标时必须显式设置。
# EVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# EVAL_EMBEDDING_API_KEY=
# EVAL_EMBEDDING_MODEL=text-embedding-3-small
# EVAL_EMBEDDING_DIMS=2048
# EVAL_TIMEOUT_SECONDS=120
# EVAL_MAX_WORKERS=4
# EVAL_MAX_RETRIES=2
# EVAL_OUTPUT_ROOT=storage/evaluations

# ==================== Authentication ====================
# 登录强制开启。首次启动前请为 admin 设置一个强密码。
AUTH_DB_PATH=storage/auth.db
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=
AUTH_SESSION_TTL_HOURS=24

# ==================== 存储路径（通常无需修改）====================
PIPELINE_ARCHIVE_ROOT=storage/pipeline_archives
RAGFLOW_FILE_ROOT=storage/pipeline_archives

# ==================== 提示词（可选，覆盖默认 Agent 提示词）====================
# SYSTEM_PROMPT=你是一个专业的硬件技术助手...（支持 {kb_name} 与 {workflow} 占位符；导出文件由服务器异步生成，禁止生成 HTML 兜底）
# NO_CONTEXT_PROMPT=（知识库中未检索到任何证据时返回给用户的最终回答）

# ==================== CLI / API 服务（可选）====================
# hardware-database-server 监听地址与端口（服务端）。
HDB_API_HOST=127.0.0.1
HDB_API_PORT=8001
# CLI 连接的 API 地址。优先级: --api-url > HDB_API_URL > 会话文件 > 默认 http://127.0.0.1:8001
HDB_API_URL=http://127.0.0.1:8001
# CORS 允许的来源（逗号分隔，浏览器前端用）。未设置时默认本地开发 origin
# （Streamlit 8501 + 前端 dev 3000/5175/5176）。生产部署必须显式设为前端实际域名。
HDB_API_CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# CLI 访问令牌（免 login，便于脚本/CI；也可用 --token 传入）。
# HDB_TOKEN=

# ==================== 会话附件（CHAT ATTACHMENTS）====================
# 会话附件功能总开关。默认开启；设置为 false 可关闭。
# 详见 docs/superpowers/specs/2026-09-03-local-chat-attachment-routing-design.md
CHAT_ATTACHMENTS_ENABLED=true
# 附件物理存储与索引数据库路径（相对 storage/ 解析）。
# CHAT_ATTACHMENT_STORAGE_DIR=storage/chat_attachments
# CHAT_ATTACHMENT_INDEX_DB_PATH=storage/chat_attachments.db
# 单文件大小上限 / 每会话附件数量上限。
# CHAT_ATTACHMENT_MAX_BYTES=52428800
# CHAT_ATTACHMENT_MAX_FILES_PER_SESSION=20
# PDF 页数 / XLSX 行数与单元格 / OOXML 解压后字节的解析期硬上限（zip 炸弹防护）。
# CHAT_ATTACHMENT_MAX_PAGES=300
# CHAT_ATTACHMENT_MAX_ROWS=200000
# CHAT_ATTACHMENT_MAX_CELLS=2000000
# CHAT_ATTACHMENT_MAX_SHEETS=100
# CHAT_ATTACHMENT_MAX_SHARED_STRINGS=1000000
# CHAT_ATTACHMENT_MAX_CELL_TEXT_LENGTH=100000
# CHAT_ATTACHMENT_MAX_UNCOMPRESSED_BYTES=209715200
# 解析任务超时 / 附件保留期（秒）/ 附件上下文 token 预算与占模型上下文比例。
# CHAT_ATTACHMENT_PARSE_TIMEOUT_SECONDS=120
# CHAT_ATTACHMENT_RETENTION_SECONDS=2592000
# CHAT_ATTACHMENT_CONTEXT_MAX_TOKENS=8000
# CHAT_ATTACHMENT_CONTEXT_RATIO=0.3
# 检索开关：FTS5 / trigram（CJK 与 >=3 字符子串）。
# CHAT_ATTACHMENT_FTS_ENABLED=true
# CHAT_ATTACHMENT_TRIGRAM_ENABLED=true
# Dense 是显式可选增强；启用时请同时配置独立 embedding 凭据，绝不复用 memory key。
# CHAT_ATTACHMENT_DENSE_ENABLED=false
# CHAT_ATTACHMENT_RETRIEVAL_MODE=lexical
# CHAT_ATTACHMENT_EMBEDDING_PROVIDER=openai_compatible
# CHAT_ATTACHMENT_EMBEDDING_BASE_URL=https://api.example.com/v1
# CHAT_ATTACHMENT_EMBEDDING_MODEL=text-embedding-3-small
# CHAT_ATTACHMENT_EMBEDDING_API_KEY=
# CHAT_ATTACHMENT_DENSE_MAX_PARTS=4000
# OCR / 远程视觉（Phase 6 增强，默认全部关闭；开启需自担外部推理策略）。
# CHAT_ATTACHMENT_OCR_ENABLED=false
# CHAT_ATTACHMENT_VISUAL_ENABLED=false
# CHAT_ATTACHMENT_REMOTE_INFERENCE_ALLOWED=false
# 视觉供应商只接收选中的 PDF 页面图片；ARK_API_KEY 不与 memory embedding key 复用。
# CHAT_ATTACHMENT_VISUAL_PROVIDER=volcengine_ark
