# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
# Ignore all storage/ contents, but keep .gitkeep
storage/**
!storage/.gitkeep

# Ignore all data/ contents, but keep .gitkeep
data/**
!data/.gitkeep

.idea/

# Ruff cache
.ruff_cache/

# Pytest cache
.pytest_cache/

# Streamlit logs
streamlit.log
streamlit.err.log
streamlit.out.log

# Local verification scratch dirs
.tmp_ragflow*/
.tmp_pycache/
ragflow_store_*/


.agents/

.tests/

# Claude Code local settings
.claude/settings.local.json

# Local diagnostic scripts and output (may contain secrets)
/_diag_auth.py
/_diag_out.txt
/_verify.txt

# macOS Finder metadata
.DS_Store

# Local development plans / specs (not version-controlled)
docs/superpowers/

# Generated evaluation artifacts
evaluation/reports/
evaluation/results/
evaluation/snapshots/
evaluation/.cache/
storage/evaluations/

# Local test and coverage artifacts
.coverage
htmlcov/
*.log

# Generated parser tables in the vendored SpyDrNet source
/src/circuit/vendor/spydrnet/**/parser.out
/src/circuit/vendor/spydrnet/**/parsetab.py
